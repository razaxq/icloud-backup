#!/bin/bash
# fnOS lifecycle entry point: start | stop | status | reload
set -u
umask 077

: "${TRIM_APPDEST:?}" "${TRIM_PKGVAR:?}"
state="${TRIM_PKGVAR}/state"
pidfile="${TRIM_PKGVAR}/server.pid"
rootsfile="${TRIM_PKGVAR}/roots"
logfile="${TRIM_PKGVAR}/server.log"
server="${TRIM_APPDEST}/web/server.py"
# fnOS runtime packages are used through PATH (install_dep_apps=python312).
export PATH="/var/apps/python312/target/bin:${PATH:-/usr/bin:/bin}"
export ICLOUD_STATE_DIR="$state"
export ICLOUD_SOCKET="${TRIM_APPDEST}/app.sock"
export ICLOUD_PREFIX="/app/icloud-photos"
export ICLOUDPD_BIN="${TRIM_APPDEST}/bin/icloudpd"
export ICLOUD_ROOTS_FILE="$rootsfile"
export ICLOUD_APP_VERSION="${TRIM_APPVER:-}"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

fail() {
    printf '%s\n' "$1" >&2
    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
    fi
    return 1
}

find_python() {
    local name candidate
    for name in python3.12 python3; do
        candidate="$(command -v "$name" 2>/dev/null)" || continue
        if "$candidate" -c 'import sys; sys.exit(sys.implementation.name != "cpython" or sys.version_info[:2] != (3, 12))' 2>/dev/null; then
            python_bin="$candidate"
            export ICLOUD_PYTHON="$candidate"
            return 0
        fi
    done
    return 1
}

# The declared share comes first and is the default destination; folders the
# administrator authorizes in the app settings follow. One path per line.
write_roots() {
    local tmp path shares extra
    IFS=':' read -r -a shares <<< "${TRIM_DATA_SHARE_PATHS:-}"
    IFS=':' read -r -a extra <<< "${TRIM_DATA_ACCESSIBLE_PATHS:-}"
    tmp="$(mktemp "${rootsfile}.XXXXXX")" || return 1
    {
        printf '%s\n' "${shares[0]:-}"
        for path in "${shares[@]}" "${extra[@]}"; do
            [[ -n "$path" ]] && printf '%s\n' "$path"
        done
    } > "$tmp" && mv -f -- "$tmp" "$rootsfile"
}

read_pid() {
    [[ -f "$pidfile" ]] && read -r pid < "$pidfile" &&
        [[ "$pid" =~ ^[1-9][0-9]*$ ]]
}

read_running_pid() {
    read_pid && grep -Fzxq -- "$server" "/proc/$pid/cmdline" 2>/dev/null &&
        grep -Fzxq -- "ICLOUD_STATE_DIR=$state" "/proc/$pid/environ" 2>/dev/null
}

# Verify the inherited directory marker on every live member. A saved numeric
# session ID alone could belong to an unrelated process after a reboot.
session_pids() {
    local sid="$1" file line rest member proc_state session
    for file in /proc/[0-9]*/stat; do
        read -r line < "$file" 2>/dev/null || continue
        member="${line%% *}"
        rest="${line##*) }"
        read -r proc_state _ _ session _ <<< "$rest"
        if [[ "$session" == "$sid" && "$proc_state" != Z ]] &&
            grep -Fzxq -- "ICLOUD_STATE_DIR=$state" "/proc/$member/environ" 2>/dev/null; then
            printf '%s\n' "$member"
        fi
    done
}

reap_session() {
    local sid="$1" sig member attempt members
    for sig in TERM KILL; do
        members="$(session_pids "$sid")"
        [[ -n "$members" ]] || return 0
        while read -r member; do
            kill -"$sig" "$member" 2>/dev/null || true
        done <<< "$members"
        for ((attempt = 0; attempt < 25; attempt++)); do
            [[ -n "$(session_pids "$sid")" ]] || return 0
            sleep 0.1
        done
    done
    fail '上次下载的进程仍在运行，暂时无法重新启动。'
}

start_app() {
    if read_running_pid; then
        [[ -S "$ICLOUD_SOCKET" ]] || { fail '服务进程仍在，但网关未就绪。请先停止应用再启动。'; return 1; }
        return 0
    fi
    if read_pid; then reap_session "$pid" || return 1; fi
    find_python || { fail '缺少飞牛 Python 3.12 运行环境，请先在应用中心安装 Python 3.12。'; return 1; }
    [[ -r "$server" && -x "$ICLOUDPD_BIN" ]] || { fail '应用文件不完整，请重新安装对应架构的安装包。'; return 1; }
    if ! mkdir -p -- "$state" || ! chmod 700 "$state"; then
        fail '无法创建应用数据目录，请检查存储空间。'; return 1
    fi
    write_roots || { fail '无法写入授权目录列表，请检查存储空间。'; return 1; }
    cd -- "${TRIM_APPDEST}/web" || { fail '应用文件不完整，请重新安装。'; return 1; }
    if [[ -S "$ICLOUD_SOCKET" ]]; then rm -f -- "$ICLOUD_SOCKET" || return 1; fi
    # Closing the lifecycle lock in the daemon lets future status and stop calls proceed.
    setsid "$python_bin" "$server" </dev/null >> "$logfile" 2>&1 9>&- &
    pid=$!
    printf '%s\n' "$pid" > "$pidfile"
    for ((i = 0; i < 100; i++)); do
        if ! kill -0 "$pid" 2>/dev/null; then break; fi
        if [[ -S "$ICLOUD_SOCKET" ]]; then return 0; fi
        sleep 0.1
    done
    stop_app
    fail '启动失败，详情见应用数据目录中的 server.log。'
}

stop_app() {
    if read_running_pid; then
        # The server cancels its download, records the interruption and exits.
        kill -TERM "$pid" 2>/dev/null || true
        for ((i = 0; i < 100; i++)); do
            read_running_pid || break
            sleep 0.2
        done
    fi
    if read_pid; then reap_session "$pid" || return 1; fi
    rm -f -- "$pidfile"
    if [[ -S "$ICLOUD_SOCKET" ]]; then rm -f -- "$ICLOUD_SOCKET"; fi
    return 0
}

reload_app() {
    write_roots || { fail '无法更新授权目录列表，请检查存储空间。'; return 1; }
    # Authorization changes do not need a restart, so a running download continues.
    if read_running_pid; then kill -HUP "$pid" 2>/dev/null || true; fi
    return 0
}

mkdir -p -- "$TRIM_PKGVAR" || { fail '无法访问应用数据目录。'; exit 1; }
exec 9>"${TRIM_PKGVAR}/lifecycle.lock" || exit 1
flock -x 9 || exit 1
case "${1:-}" in
    start) start_app || exit 1 ;;
    stop) stop_app || exit 1 ;;
    reload) reload_app || exit 1 ;;
    status) read_running_pid && [[ -S "$ICLOUD_SOCKET" ]] || exit 3 ;;
    *) fail "未知的生命周期命令：${1:-}"; exit 1 ;;
esac
exit 0
